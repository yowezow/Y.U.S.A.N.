{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the YUSAN desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-toggle-maximize",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/yusan-core",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill"
  ]
}
