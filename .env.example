# Development-only fallback. Packaged users configure Gemini in YUSAN Settings;
# keys are stored in the OS credential manager, not in this file.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# The default model is centralized in yusan_core.config.settings and can be
# overridden for development or a managed deployment.
GEMINI_MODEL=gemini-3.8-flash
YUSAN_HOST=127.0.0.1
YUSAN_PORT=8765
YUSAN_LOG_LEVEL=INFO
